generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

enum Role {
  STUDENT
  ADMIN
}

enum AssignmentStatus {
  PENDING
  SUBMITTED
  GRADED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum SkillCategory {
  TECHNICAL
  SOFT
}

enum ApplicationStatus {
  APPLIED
  INTERVIEWING
  OFFERED
  REJECTED
}

enum NotificationType {
  ASSIGNMENT_REMINDER
  AI_INSIGHT
  PLACEMENT_ALERT
  ADMIN_ANNOUNCEMENT
}

enum AIExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum AIModule {
  RESUME
  STUDY_PLAN
  NOTES
}

enum StudyPlanStatus {
  ACTIVE
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum CalendarEventType {
  EXAM
  HOLIDAY
  COLLEGE_EVENT
  CLASS
}

// ---------------------------------------------------------
// 1. IDENTITY, ACCESS & SETTINGS
// ---------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Password reset (hashed token stored, not plaintext)
  passwordResetTokenHash String?
  passwordResetExpires   DateTime?

  // Email verification
  verificationTokenHash  String?
  verificationExpires    DateTime?

  studentProfile StudentProfile?
  adminProfile   AdminProfile?
  settings       StudentSettings?
  notifications  Notification[]
}

model StudentProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  university     String?
  enrollmentYear Int?
  graduationYear Int?
  careerGoals    String?  @db.Text
  socialLinks    Json?    // { linkedin, github, portfolio, twitter }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  semesters        Semester[]
  tasks            Task[]
  reminders        Reminder[]
  studyPlans       StudyPlan[]
  calendarEvents   CalendarEvent[]
  resumes          Resume[]
  skills           Skill[]
  certifications   Certification[]
  projects         Project[]
  studentAnalytics StudentAnalytics?
  aiExecutionLogs  AIExecutionLog[]
  jobApplications  JobApplication[]
}

model AdminProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  department       String?
  permissionsLevel Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model StudentSettings {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationPreferences Json?
  
  // Explicit relation to Semester as requested
  defaultSemesterId       String?
  defaultSemester         Semester? @relation("SemesterToSettings", fields: [defaultSemesterId], references: [id], onDelete: SetNull)
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        NotificationType
  triggerTime DateTime?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// ---------------------------------------------------------
// 2. ACADEMIC HUB (Ownership Hierarchy)
// ---------------------------------------------------------

model Semester {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  name             String
  startDate        DateTime
  endDate          DateTime
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  subjects        Subject[]
  studentSettings StudentSettings[] @relation("SemesterToSettings")
}

model Subject {
  id              String     @id @default(uuid())
  semesterId      String
  semester        Semester   @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  name            String
  code            String?
  credits         Int?
  targetGrade     Float?
  totalClasses    Int        @default(0)
  attendedClasses Int        @default(0)
  attendanceGoal  Float?     // e.g. 75.0 = 75% target attendance
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  assignments       Assignment[]
  notes             Note[]
  attendanceRecords AttendanceRecord[]
}

model Assignment {
  id          String           @id @default(uuid())
  subjectId   String
  subject     Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  priority    Priority         @default(MEDIUM)
  status      AssignmentStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Note {
  id        String   @id @default(uuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title     String
  content   String?  @db.Text
  fileUrl   String?
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudyPlan {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  title            String
  targetDate       DateTime?
  goals            String?        @db.Text
  status           StudyPlanStatus @default(ACTIVE)
  progressPercentage Float        @default(0.0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tasks Task[]
}

model AttendanceRecord {
  id          String           @id @default(uuid())
  subjectId   String
  subject     Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  date        DateTime
  status      AttendanceStatus
  notes       String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model CalendarEvent {
  id               String            @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  title            String
  description      String?           @db.Text
  date             DateTime
  endDate          DateTime?
  eventType        CalendarEventType
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

// ---------------------------------------------------------
// 3. PRODUCTIVITY & ANALYTICS HUB
// ---------------------------------------------------------

model Task {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  
  // Optional relation to StudyPlan
  studyPlanId      String?
  studyPlan        StudyPlan?     @relation(fields: [studyPlanId], references: [id], onDelete: SetNull)

  title       String
  description String?        @db.Text
  dueDate     DateTime?
  priority    Priority       @default(MEDIUM)
  status      TaskStatus     @default(TODO)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Reminder {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  title            String
  description      String?        @db.Text
  triggerAt        DateTime
  isCompleted      Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model StudentAnalytics {
  id                   String         @id @default(uuid())
  studentProfileId     String         @unique
  studentProfile       StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  attendancePercentage Float          @default(0.0)
  taskCompletionRate   Float          @default(0.0)
  averageAtsScore      Float          @default(0.0)
  generatedAt          DateTime       @default(now())
}

// ---------------------------------------------------------
// 4. CAREER HUB
// ---------------------------------------------------------

model Resume {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  title            String
  isActive         Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  versions ResumeVersion[]
}

model ResumeVersion {
  id             String   @id @default(uuid())
  resumeId       String
  resume         Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  content        Json
  templateId     String?  // C-1: e.g. "classic", "modern", "minimal"
  atsScore       Float?
  reviewFeedback String?  @db.Text
  createdAt      DateTime @default(now())
}

model Skill {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  name             String
  category         SkillCategory
  proficiencyLevel Int            @default(1) // E.g., 1 to 5 scale
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model JobApplication {
  id               String            @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  companyName      String
  role             String
  applicationUrl   String?
  notes            String?           @db.Text
  appliedDate      DateTime?
  status           ApplicationStatus @default(APPLIED)

  // C-5: Interview Scheduling
  interviewDate    DateTime?
  interviewRound   String?           // e.g. "HR Screen", "Technical Round 1", "Final"

  // C-6: Offer Details (stored as structured JSON)
  offerDetails     Json?             // { salary, currency, benefits, deadline, notes }

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

// ---------------------------------------------------------
// C-3: CERTIFICATIONS
// ---------------------------------------------------------

model Certification {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  name             String
  issuer           String
  dateObtained     DateTime?
  expiryDate       DateTime?      // Used for certification renewal reminders
  credentialId     String?
  credentialUrl    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// ---------------------------------------------------------
// C-4: PERSONAL PROJECTS
// ---------------------------------------------------------

model Project {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  title            String
  description      String?        @db.Text
  technologies     String[]       // e.g. ["React", "Node.js", "PostgreSQL"]
  projectUrl       String?
  repoUrl          String?
  startDate        DateTime?
  endDate          DateTime?
  isOngoing        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// ---------------------------------------------------------
// 5. AI EXECUTION HISTORY
// ---------------------------------------------------------

model AIExecutionLog {
  id               String            @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  module           AIModule
  operation        String
  status           AIExecutionStatus @default(PENDING)
  startedAt        DateTime          @default(now())
  completedAt      DateTime?
  errorMessage     String?           @db.Text
}
