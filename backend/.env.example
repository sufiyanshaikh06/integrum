# Supabase Managed Database Connection Separation:
# DATABASE_URL: Transaction Pooler on port 6543 (PgBouncer) for runtime queries
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: Direct Connection or Session Pooler on port 5432 for Prisma migrations
DIRECT_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

JWT_ACCESS_SECRET="your_access_secret_min_32_characters_here"
JWT_REFRESH_SECRET="your_refresh_secret_min_32_characters_here"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=10
CLIENT_URL="https://integrum-app.vercel.app"
PORT=5000
NODE_ENV="production"
COOKIE_SAME_SITE="lax"
COOKIE_SECURE=true
REMINDER_INTERVAL_MS=60000
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Set only for a verified deployment proxy topology; direct access defaults to zero.
TRUST_PROXY_HOPS=0

# Production email: select resend and configure a verified sender address.
EMAIL_PROVIDER=console
# RESEND_API_KEY=your-provider-key
# EMAIL_FROM=notifications@your-verified-domain.example
