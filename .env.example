# ==========================================
# Integrum Environment Variable Template
# ==========================================

# -----------------
# Backend (Express)
# -----------------
PORT=5000
NODE_ENV=development

# Database configuration (Supabase/Neon)
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# Authentication
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# AI Provider Integration
# Note: The platform uses an abstracted AIService. Provide the key for the active provider.
AI_PROVIDER="gemini" # Options: gemini, openai, claude
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"

# -----------------
# Frontend (Vite)
# -----------------
# All frontend environment variables must be prefixed with VITE_
VITE_API_BASE_URL="http://localhost:5000/api/v1"
