# ==========================================
# Integrum Environment Variable Template
# ==========================================

# -----------------
# Backend (Express)
# -----------------
PORT=5000
NODE_ENV=development

# Database configuration (Supabase PostgreSQL Connection Separation)
# DATABASE_URL: Transaction Pooler on port 6543 (PgBouncer) for runtime queries
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: Direct Connection or Session Pooler on port 5432 for Prisma migrations
DIRECT_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

# Authentication & Session Security
JWT_ACCESS_SECRET="your-super-secret-jwt-access-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-min-32-chars"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
COOKIE_SAME_SITE="lax"
COOKIE_SECURE=true
CLIENT_URL="https://integrum-app.vercel.app"
REMINDER_INTERVAL_MS=60000

# AI Provider Integration (Abstracted AIService; default: mock)
AI_PROVIDER="mock" # Options: mock, gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# -----------------
# Frontend (Vite)
# -----------------
# All frontend environment variables must be prefixed with VITE_
VITE_API_BASE_URL="http://localhost:5000/api/v1"
